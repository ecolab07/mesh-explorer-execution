{
  "name": "@mesh/conformance-tests",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:artifacts-clean": "node ./scripts/check-artifacts-clean.mjs",
    "check:critical": "node ./scripts/check-critical-gate.mjs",
    "test": "cross-env MESH_TX_VISIBILITY_POLICY=acl vitest run",
    "pretest": "node ./scripts/check-no-todo.mjs",
    "posttest": "node ./scripts/generate-evidence.mjs"
  },
  "dependencies": {
    "@mesh/conformance-harness": "workspace:*",
    "@mesh/shared": "workspace:*",
    "@mesh/eventstore-local": "workspace:*",
    "@mesh/kernel-minimal": "workspace:*",
    "@mesh/projection-minimal": "workspace:*",
    "@mesh/sync-local": "workspace:*",
    "@mesh/snapshot-minimal": "workspace:*",
    "@mesh/sync-http": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
